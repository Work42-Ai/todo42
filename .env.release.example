# Copy to .env.release.local (gitignored) and fill in. Names only — never commit secrets.
#
# The Developer ID Application certificate must be in your login Keychain:
#   security find-identity -v -p codesigning
WORK42_DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (TEAMID)"

# Notarization: either a saved notarytool profile (recommended) ...
#   xcrun notarytool store-credentials work42-notary
WORK42_NOTARY_KEYCHAIN_PROFILE="work42-notary"

# ... or an Apple ID with an app-specific password (leave the profile empty to use these).
APPLE_ID=""
APPLE_TEAM_ID=""
APPLE_APP_PASSWORD=""
